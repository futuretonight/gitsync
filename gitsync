# --------------------------------------------------------------------
#  MAIN INTERACTIVE WIZARD
# --------------------------------------------------------------------
main_wizard() {
    clear || true
    print_banner

    # Check git user config
    local uname uemail
    uname=$(git config user.name 2>/dev/null || true)
    uemail=$(git config user.email 2>/dev/null || true)
    if [ -z "$uname" ]; then
        print_warning "user.name is not configured."
        read -r -p "Enter your name for Git commits: " new_name
        [ -n "$new_name" ] && git config --global user.name "$new_name"
    fi
    if [ -z "$uemail" ]; then
        print_warning "user.email is not configured."
        read -r -p "Enter your email for Git commits: " new_email
        [ -n "$new_email" ] && git config --global user.email "$new_email"
    fi

    print_section "STEP 1 - REPOSITORY CHECK"
    if [ "$IS_IN_REPO" -ne 1 ]; then
        print_warning "Current folder is not a Git repository."
        read -r -p "Initialize a new Git repository here? (y/n): " do_init
        if [ "$do_init" = "y" ] || [ "$do_init" = "Y" ]; then
            git init
            git checkout -b "$DEFAULT_BRANCH" 2>/dev/null || git branch -M "$DEFAULT_BRANCH" 2>/dev/null || true
            print_success "Git repository initialized."
            IS_IN_REPO=1
        else
            print_info "Aborted."
            exit 1
        fi
    else
        print_success "Git repository detected: $REPO_ROOT"
    fi

    print_section "STEP 2 - LOCAL COMMIT"
    print_step "Working tree status:"
    git status -s
    echo ""
    local dirty_cnt
    dirty_cnt=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    if [ "$dirty_cnt" -gt 0 ]; then
        read -r -p "Stage all changes and commit? (y/n): " do_commit
        if [ "$do_commit" = "y" ] || [ "$do_commit" = "Y" ]; then
            read -r -p "Commit message (blank = auto): " c_msg
            [ -z "$c_msg" ] && c_msg="Update $(date '+%Y-%m-%d %H:%M:%S')"
            git add -A
            git commit -m "$c_msg"
            print_success "Committed: '$c_msg'"
        fi
    else
        print_info "Working directory is clean. Nothing to commit."
    fi

    print_section "STEP 3 - REMOTE PUSH"
    read -r -p "Push changes to remote? (y/n): " do_push
    if [ "$do_push" = "y" ] || [ "$do_push" = "Y" ]; then
        local r_url
        r_url=$(git remote get-url origin 2>/dev/null || true)
        if [ -z "$r_url" ]; then
            print_warning "No 'origin' remote found."
            read -r -p "Enter remote Git URL: " new_rurl
            if [ -n "$new_rurl" ]; then
                git remote add origin "$new_rurl"
                print_success "Remote added: $new_rurl"
            fi
        fi

        local cur_br
        cur_br=$(git branch --show-current 2>/dev/null || echo "$DEFAULT_BRANCH")
        read -r -p "Pull with rebase first? (recommended) (y/n): " do_pfirst
        if [ "$do_pfirst" = "y" ] || [ "$do_pfirst" = "Y" ]; then
            set +e
            git pull --rebase origin "$cur_br" 2>/dev/null
            set -e
        fi

        print_step "Pushing $cur_br to origin..."
        git push -u origin "$cur_br"
        print_success "Pushed to origin/$cur_br successfully!"
    fi

    print_section "WIZARD COMPLETE"
    print_success "All tasks completed successfully."
    print_info    "Run 'gitsync help' to view all direct commands."
    echo ""
}

# --------------------------------------------------------------------
#  ARGUMENT ROUTER
# --------------------------------------------------------------------
CMD="$1"
ARG2="$2"
ARG3="$3"

case "$CMD" in
    ""|"wizard")
        main_wizard
        ;;
    "help"|"-h"|"--help"|"?")
        show_help
        ;;
    "version"|"-v"|"--version")
        echo "$SCRIPT_NAME version $SCRIPT_VERSION (Git $GIT_VERSION)"
        ;;
    "status"|"s")
        require_repo
        echo ""
        echo -e "${C_BOLD}${C_BLUE}[ GIT STATUS ]${C_RESET}"
        echo -e "${C_DIM}${THIN_DIVIDER}${C_RESET}"
        git status -s
        echo ""
        echo -e "${C_BOLD}${C_BLUE}[ STAGED CHANGES ]${C_RESET}"
        git diff --cached --stat
        echo ""
        echo -e "${C_BOLD}${C_BLUE}[ UNSTAGED CHANGES ]${C_RESET}"
        git diff --stat
        echo -e "${C_DIM}${THIN_DIVIDER}${C_RESET}"
        ;;
    "log"|"l")
        require_repo
        echo ""
        echo -e "${C_BOLD}${C_BLUE}[ RECENT COMMITS (15) ]${C_RESET}"
        echo -e "${C_DIM}${THIN_DIVIDER}${C_RESET}"
        git log --oneline --graph --decorate --color -15
        ;;
    "logfull")
        require_repo
        echo ""
        echo -e "${C_BOLD}${C_BLUE}[ FULL COMMIT HISTORY ]${C_RESET}"
        echo -e "${C_DIM}${THIN_DIVIDER}${C_RESET}"
        git log --graph --decorate --color --format="%C(yellow)%h%Creset %s %C(cyan)(%cr)%Creset %C(bold blue)%an%Creset" -30
        ;;
    "diff")
        require_repo
        if [ -n "$ARG2" ]; then
            git diff "$ARG2"
        else
            git diff
        fi
        ;;
    "commit"|"c")
        require_repo
        cmsg="$ARG2"
        if [ -z "$cmsg" ]; then
            read -r -p "Commit message: " cmsg
        fi
        [ -z "$cmsg" ] && cmsg="Update $(date '+%Y-%m-%d %H:%M:%S')"
        git add -A
        git commit -m "$cmsg"
        print_success "Committed: '$cmsg'"
        cache_write "COMMIT: $cmsg"
        ;;
    "push"|"p")
        require_repo
        pbr="$ARG2"
        [ -z "$pbr" ] && pbr=$(git branch --show-current 2>/dev/null || echo "$DEFAULT_BRANCH")
        print_step "Pushing to origin/$pbr..."
        git push -u origin "$pbr"
        print_success "Pushed to origin/$pbr"
        ;;
    "pull")
        require_repo
        pbr="$ARG2"
        [ -z "$pbr" ] && pbr=$(git branch --show-current 2>/dev/null || echo "$DEFAULT_BRANCH")
        dirty_cnt=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        did_as=0
        if [ "$dirty_cnt" -gt 0 ]; then
            print_step "Auto-stashing changes before pull..."
            do_tracked_stash_internal "Auto-stash before pull" "AUTO-STASH"
            did_as=1
        fi
        print_step "Pulling from origin/$pbr (--rebase)..."
        git pull --rebase origin "$pbr"
        if [ "$did_as" -eq 1 ]; then
            print_step "Restoring auto-stash..."
            git stash pop
        fi
        print_success "Pull complete."
        ;;
    "sync")
        full_sync "$@"
        ;;
    "pop")
        do_tracked_stash_pop "stash@{0}"
        ;;
    "stash"|"st")
        case "$ARG2" in
            "")
                stash_menu
                ;;
            "pop")
                target="stash@{0}"
                [ -n "$ARG3" ] && target="stash@{$ARG3}"
                do_tracked_stash_pop "$target"
                ;;
            "save"|"push")
                do_tracked_stash_internal "$ARG3" "STASH-SAVE"
                ;;
            "history"|"log"|"track")
                stash_history
                ;;
            "recover")
                stash_recover
                ;;
            "list")
                require_repo
                git stash list
                ;;
            "show")
                require_repo
                s_idx="${ARG3:-0}"
                git stash show -p "stash@{$s_idx}"
                ;;
            "drop")
                require_repo
                d_idx="${ARG3:-0}"
                git stash drop "stash@{$d_idx}"
                ;;
            "clear")
                require_repo
                git stash clear
                print_success "All stashes cleared."
                ;;
            *)
                print_error "Unknown stash action: $ARG2"
                ;;
        esac
        ;;
    "undo")
        require_repo
        read -r -p "Undo last commit (keep changes staged)? (y/n): " uconf
        if [ "$uconf" = "y" ] || [ "$uconf" = "Y" ]; then
            git reset HEAD~1 --soft
            print_success "Last commit undone. Files are staged."
        fi
        ;;
    "amend")
        require_repo
        if [ -n "$ARG2" ]; then
            git commit --amend -m "$ARG2"
        else
            git commit --amend
        fi
        print_success "Last commit amended."
        ;;
    "clean")
        require_repo
        git clean -nd
        read -r -p "Delete untracked files? (y/n): " cconf
        if [ "$cconf" = "y" ] || [ "$cconf" = "Y" ]; then
            git clean -fd
            print_success "Working directory cleaned."
        fi
        ;;
    "fetch")
        require_repo
        git fetch --all --prune
        print_success "All remotes fetched."
        ;;
    "branch"|"br")
        require_repo
        case "$ARG2" in
            "")
                echo "Current branch: $(git branch --show-current 2>/dev/null)"
                echo ""
                git branch -a
                ;;
            "create")
                [ -z "$ARG3" ] && { read -r -p "New branch name: " bname; } || bname="$ARG3"
                git checkout -b "$bname"
                ;;
            "switch")
                [ -z "$ARG3" ] && { read -r -p "Branch name to switch to: " bname; } || bname="$ARG3"
                git checkout "$bname"
                ;;
            "delete")
                [ -z "$ARG3" ] && { read -r -p "Branch name to delete: " bname; } || bname="$ARG3"
                git branch -d "$bname"
                ;;
            "merge")
                [ -z "$ARG3" ] && { read -r -p "Branch to merge into current: " bname; } || bname="$ARG3"
                git merge "$bname"
                ;;
            *)
                git branch -a
                ;;
        esac
        ;;
    "doctor")
        run_doctor
        ;;
    "whoami")
        echo "Git User:  $(git config user.name 2>/dev/null || echo 'not set')"
        echo "Git Email: $(git config user.email 2>/dev/null || echo 'not set')"
        ;;
    "conflicts")
        require_repo
        git status | grep -E "conflict|Unmerged" || print_success "No conflicts found."
        ;;
    *)
        print_error "Unknown command: '$CMD'"
        print_info  "Run 'gitsync help' to view all available commands."
        exit 1
        ;;
esac
